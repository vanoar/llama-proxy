{
  "listen_addr": ":8080",
  "backend_addr": "127.0.0.1:8081",
  "llama_bin": "./llama.cpp/build/bin/llama-server",
  "cwd": ".",
  "load_timeout": "15m",

  "models": [
    {
      "name": "Muse-Glimmer-30B",
      "aliases": ["Muse-Glimmer-30B", "muse"],
      "env": {
        "GGML_OP_OFFLOAD_MIN_BATCH": "2048"
      },
      "args": [
        "-hf", "unsloth/Muse-Glimmer-30B-GGUF:UD-Q6_K_XL",
        "-c", "500000",
        "-n", "32000",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "64",
        "-ctk", "q8_0",
        "-ctv", "q8_0",
        "--host", "0.0.0.0",
        "--metrics"
      ]
    },
    {
      "name": "Qwen3.8-27b",
      "aliases": ["Qwen3.8-27b", "qwen"],
      "env": {
        "GGML_CUDA_ENABLE_UNIFIED_MEMORY": "1",
        "MTMD_BACKEND_DEVICE": "none",
        "GGML_OP_OFFLOAD_MIN_BATCH": "2048"
      },
      "args": [
        "-hf", "unsloth/Qwen3.8-27B-GGUF:UD-Q8_K_XL",
        "-c", "262144",
        "-n", "32000",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--min-p", "0.0",
        "-ctk", "q8_0",
        "-ctv", "q8_0",
        "--host", "0.0.0.0",
        "--metrics",
        "--spec-type", "draft-mtp",
        "--spec-draft-n-max", "4"
      ]
    }
  ]
}
